# gates_of_heck configuration. All keys optional; delete what you don't use.
# Full key reference: docs/config.md in the gates_of_heck checkout
# (or .gatesrc.example there for a commented starter with every key).
GOH_MAX_LINES=500                 # file-length cap; unset disables the check
# GOH_EXCLUDE='vendor/|\.generated\.'   # shared vendor/generated exemption
# GOH_ALLOW='<glyph>'                          # extra permitted characters (keep minimal)
# GOH_LINE_EXCLUDE='third_party/'       # length-only alias
# GOH_PY_COV_MIN=95
# GOH_SWIFT_MODE=xcode            # or spm
# GOH_SWIFT_SCHEME=MyAppTests
# GOH_SWIFT_COV_MIN=95
# GOH_MAX_SCRATCH_GB=25 etc. live OUTSIDE the gates since v0.8.0 — set them
# in the environment for the scripts repo's bin/disk_hygiene.sh, not here.

# No process kill by name (gates_of_heck check_no_kill_by_name.py, 2026-09-23).
# A name matches processes this repo does not own. Today's survivors are in
# kill_by_name_allow.json (1 entry, reviewed 2026-10-15 and re-measured
# 2026-10-20 -- 0 unreviewed); a new kill by
# name fails, and a fixed one must take its entry with it.
GOH_NO_KILL_BY_NAME=1

# Every scanner's floor (goh v0.27.0, docs/config.md): a full-scope scan that
# reads less than this has lost its subject and is red, not clean. Nine tenths
# of what each read on 2026-10-14 (the house rule); lower one with the tree in
# the same commit, never to absorb a scan that went blind. The last two were
# measured 2026-10-19: the step named them as the scanners that read
# something and declared no floor, which is the Phase 0 item (P0.1) unfinished
# -- a scan that stopped reading would have passed.
GOH_EMOJI_MIN_FILES=19                # read 21
GOH_CONFLICT_MARKERS_MIN_FILES=19     # read 21
GOH_FILE_LENGTH_MIN_FILES=5           # read 6
GOH_SECRETS_MIN_FILES=19              # read 21
GOH_SHELL_LINT_MIN_FILES=1            # read 1
GOH_EARLY_EXIT_PIPE_MIN_FILES=5       # read 6
GOH_DEAD_AFTER_EXEC_MIN_FILES=5       # read 6
GOH_BARE_HOOK_INDEX_MIN_FILES=5       # read 6
GOH_BARE_PYTHON_MIN_FILES=5           # read 6
GOH_MD_LINKS_MIN_LINKS=5              # read 6
GOH_TAP_WRITES_MIN_FILES=9            # read 11 (script/workflow files)
GOH_UNREAPED_SPAWN_MIN_FILES=1        # read 2 (test files)
# Every step the pre-push gate runs (tools/gate.sh --full -> goh local_ci.sh). Until
# CadGoose G0.18 nothing ran these: gate.sh --full ran the structural layer alone, and
# this line named a rust_gate the tap has no Rust for, glued to structural by a missing colon.
GOH_CI_STEPS='"$GOH_DIR/gates/structural.sh" --full:bash tools/tap_consistency.sh:bash tools/tests/test_tap_consistency.sh:bash tools/brew_style.sh:bash tools/tests/test_cask_floor.sh:bash tools/cask_floor.sh'
